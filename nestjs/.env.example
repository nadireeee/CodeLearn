# JWT
JWT_SECRET=change-me-jwt
JWT_EXPIRE_IN=1d
REFRESH_JWT_SECRET=change-me-refresh
REFRESH_JWT_EXPIRE_IN=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nestjs_user
POSTGRES_PASSWORD=nestjs_password
POSTGRES_DB=nestjs_db
url=postgresql://nestjs_user:nestjs_password@localhost:5432/nestjs_db
port=5432

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codelearn

# Gemini (required for AI features)
GEMINI_API_KEY=

# App
PORT=3000
NODE_ENV=development
